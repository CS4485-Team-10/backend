FROM public.ecr.aws/lambda/python:3.12

WORKDIR ${LAMBDA_TASK_ROOT}

# Install dependencies
COPY requirements-llm.txt .
RUN pip install --no-cache-dir -r requirements-llm.txt

# Copy pipeline code (llm_insight needs narrative_matching)
COPY pipelines/llm_insight_generation.py ./pipelines/
COPY pipelines/narrative_matching.py ./pipelines/
COPY pipelines/shared/ ./pipelines/shared/

# Copy lambda handler
COPY lambda_handlers/llm_insight_handler.py ./lambda_handlers/

# Create __init__.py files for proper imports
RUN touch pipelines/__init__.py lambda_handlers/__init__.py

CMD ["lambda_handlers.llm_insight_handler.lambda_handler"]